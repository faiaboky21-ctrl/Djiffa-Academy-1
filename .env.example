# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAIEMENT EN LIGNE (Bénin & International) — Clés conservées strictement côté serveur
# Prestataire actif : fedapay | kkiapay | cinetpay
PAYMENT_PROVIDER="fedapay"
# Mode d'exécution : sandbox | live
PAYMENT_MODE="sandbox"

# FedaPay (MTN MoMo, Moov Money, Visa, Mastercard)
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""

# KKiaPay (Bénin & UEMOA)
KKIAPAY_PUBLIC_KEY=""
KKIAPAY_PRIVATE_KEY=""
KKIAPAY_SECRET=""

# CinetPay (Afrique de l'Ouest & Centrale)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""

# Sécurité Administration (optionnel en mode démo)
ADMIN_EMAIL="faith.ariola@djiffa-agency.com"
ADMIN_ACCESS_CODE=""
# Clé HMAC permanente de signature des sessions Direction (recommandée en production Render)
ADMIN_SESSION_SECRET=""

# SUPABASE (Base de données PostgreSQL, Authentification & Stockage PDF/Médias)
# Clés publiques (sécurisées par RLS, exposées au navigateur via Vite)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Clé serveur privée (NE JAMAIS préfixer avec VITE_ — strictement côté serveur)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
